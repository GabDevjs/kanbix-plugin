{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "kanbix": {
      "type": "streamable-http",
      "url": "https://api.kanbix.com.br/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://api.kanbix.com.br/mcp",
            "baseScopes": ["offline_access"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
